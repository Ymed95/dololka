// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          String    @default("client") // "client" or "admin"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  orders        Order[]
  sentMessages  Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  category    String   // "tshirt", "hoodie", "cap", "mug", "other"
  type        String   @default("customizable") // "customizable", "textile", "materiel"
  imageUrl    String
  mockupUrl   String?  // URL for 3D/2D mockup
  model3dUrl  String?  // URL d'un modèle GLB pour l'aperçu 3D 360°
  sizes       String?  // Available sizes e.g. "XS,S,M,L,XL,2XL"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  orders      Order[]
}

model Portfolio {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String   // "branding", "web", "social", "textile", "design", "pub"
  tags        String   // Comma-separated tags
  color       String   @default("from-primary-500 to-secondary-500") // Gradient CSS classes
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  userId          String
  productId       String
  status          String   @default("pending") // "pending", "in_production", "shipped", "completed"
  totalPrice      Float
  
  // Customization data (vue principale — rétro-compatibilité)
  designFileUrl   String?  // Path to uploaded logo/design
  designFileName  String?
  position        String?  // "front-left", "front-center", "back-center", etc.
  designX         Float?   // X position on canvas
  designY         Float?   // Y position on canvas
  designWidth     Float?   // Width of design
  designHeight    Float?   // Height of design
  designRotation  Float?   // Rotation angle
  customNotes     String?  // Récapitulatif produit + livraison (généré)
  clientNotes     String?  // Précisions libres saisies par le client au moment de la personnalisation

  // Asset de production
  baseColor         String?  // Couleur de base du vêtement (hex)
  productionFileUrl String?  // Rendu HD composite de la vue principale
  customizationData Json?    // Personnalisation complète multi-vues (CustomizationData)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
  messages        Message[]
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  orderId     String?  // Optional: link to specific order
  subject     String?
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Messages du formulaire de contact envoyés par des visiteurs SANS compte :
  // pas de User expéditeur → on garde leurs coordonnées pour répondre par email.
  visitorName  String?
  visitorEmail String?

  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  order       Order?   @relation(fields: [orderId], references: [id])
}

// Service éditable depuis l'espace admin (remplace les pages statiques).
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique // URL : /services/<slug>
  title       String
  subtitle    String   @default("")
  description String   @default("")
  icon        String   @default("Sparkles") // Nom d'icône lucide-react
  features    Json?    // string[] — "Ce qui est inclus"
  process     Json?    // { title, description }[] — "Comment ça se passe"
  pricing     String?  // Encadré tarifs / devis
  faq         Json?    // { q, a }[]
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Statistique affichée sur la page d'accueil, éditable depuis l'admin.
model SiteStat {
  id        String   @id @default(cuid())
  value     String   // ex. "150+", "95%"
  label     String   // ex. "Projets réalisés"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
