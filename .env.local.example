# Base de données PostgreSQL (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET=generer_une_cle_secrete_aleatoire
NEXTAUTH_URL=https://votre-domaine.com

# Stripe (clés Live pour la production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_XXXX
STRIPE_SECRET_KEY=sk_live_XXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXX

# Stockage persistant des assets (designs + rendus de production).
# OBLIGATOIRE sur Vercel (FS éphémère). À créer dans Vercel > Storage > Blob.
# Sans ce token, l'app retombe sur le FS local (dev) puis sur la dataURL.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXX
